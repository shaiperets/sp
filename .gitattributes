# Normalize line endings in the repo
* text=auto eol=lf

# Binary assets
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.avif binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary

# Keep vendored skill data out of language stats and diffs
.claude/** linguist-vendored
package-lock.json linguist-generated -diff
